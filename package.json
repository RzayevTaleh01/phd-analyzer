{
  "name": "phd-analyzer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "PhD Analyzer - a personal PhD research and analysis system with Talvis, a Claude-powered research core",
  "license": "MIT",
  "scripts": {
    "dev": "concurrently -k -n api,web -c cyan,magenta \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "tsx watch server/start.ts",
    "dev:web": "vite",
    "build": "vite build",
    "start": "vite build && tsx server/start.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "fetch": "tsx scripts/fetch.ts",
    "browser:check": "tsx scripts/fetch.ts check",
    "browser:install": "playwright-core install chromium",
    "serve": "tsx server/start.ts",
    "db:push": "tsx scripts/db-push.ts"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/d3-force": "^3.0.10",
    "@types/express": "^5.0.6",
    "@types/node": "^20.19.43",
    "@types/pg": "^8.15.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^4.7.0",
    "concurrently": "^9.2.5",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vite": "^6.4.5"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.310",
    "@fontsource/figtree": "^5.3.0",
    "@fontsource/inter": "^5.3.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@xyflow/react": "^12.12.0",
    "better-sqlite3": "^11.10.0",
    "d3-force": "^3.0.0",
    "express": "^5.3.0",
    "fast-xml-parser": "^5.11.2",
    "lucide-react": "^1.61.0",
    "pg": "^8.23.1",
    "playwright-core": "^1.56.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "unpdf": "^1.8.1",
    "zod": "^4.6.7"
  }
}
